    "$note": "Cores utilitárias do Tailwind (gray-*, blue-*, red-*, emerald-* etc.) permanecem disponíveis via paleta default e são usadas em pontos localizados (ex.: border-gray-300 em inputs, bg-emerald-50 em badges de status)."
  },
  "typography": {
    "fontFamily": {
      "sans": ["Inter", "var(--font-inter)", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "fontSource": "next/font/local — Inter Variable (opsz,wght), normal + italic, display swap; exposto como CSS var --font-inter",
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600 },
    "fontSize": {
      "xs":   { "size": "0.75rem",  "px": 12, "lineHeight": "1.125rem", "lineHeightPx": 18 },
      "sm":   { "size": "0.875rem", "px": 14, "lineHeight": "1.25rem",  "lineHeightPx": 20 },
      "base": { "size": "1rem",     "px": 16, "lineHeight": "1.5rem",   "lineHeightPx": 24 },
      "lg":   { "size": "1.125rem", "px": 18, "lineHeight": "1.75rem",  "lineHeightPx": 28 },
      "xl":   { "size": "1.25rem",  "px": 20, "lineHeight": "1.875rem", "lineHeightPx": 30 },
      "2xl":  { "size": "1.5rem",   "px": 24, "lineHeight": "2rem",     "lineHeightPx": 32 },
      "3xl":  { "size": "1.875rem", "px": 30, "lineHeight": "2.375rem", "lineHeightPx": 38 },
      "4xl":  { "size": "2.25rem",  "px": 36, "lineHeight": "2.75rem",  "lineHeightPx": 44 }
    },
    "rootFontSize": "16px (html { font-size: var(--fontSize) }, --fontSize: 16px)"
  },
  "spacing": {
    "$base": "--spacing: 1rem (16px)",
    "scale": {
      "sm":  { "expr": "calc(var(--spacing) - 10px)", "px": 6 },
      "md":  { "expr": "calc(var(--spacing) - 8px)",  "px": 8 },
      "lg":  { "expr": "calc(var(--spacing) - 4px)",  "px": 12 },
      "2xl": { "expr": "calc(var(--spacing) + 4px)",  "px": 20 },
      "3xl": { "expr": "calc(var(--spacing) + 8px)",  "px": 24 },
      "4xl": { "expr": "calc(var(--spacing) + 16px)", "px": 32 },
      "5xl": { "expr": "calc(var(--spacing) + 24px)", "px": 40 },
      "6xl": { "expr": "calc(var(--spacing) + 28px)", "px": 44 },
      "7xl": { "expr": "calc(var(--spacing) + 48px)", "px": 64 },
      "8xl": { "expr": "calc(var(--spacing) + 64px)", "px": 80 }
    },
    "$note": "Escala default do Tailwind (p-4, gap-5, space-y-2 ...) continua ativa e é a mais usada nos componentes; a escala custom acima cobre tokens nomeados (ex.: p-4xl no container de página)."
  },
  "borderRadius": {
    "$base": "--radius: 1rem (16px)",
    "scale": {
      "sm": { "expr": "calc(var(--radius) - 14px)", "px": 2 },
      "md": { "expr": "calc(var(--radius) - 10px)", "px": 6 },
      "lg": { "expr": "calc(var(--radius) - 8px)",  "px": 8 },
      "xl": { "expr": "calc(var(--radius) - 4px)",  "px": 12 }
    },
    "$note": "rounded-full e rounded-2xl (16px, default Tailwind) usados em avatares, pills e popovers/calendário."
  },
  "elevation": {
    "$note": "Sem tokens de shadow custom. Uso pontual das sombras default do Tailwind: shadow-sm (inputs/alerts), shadow-none (Card por padrão), shadow-xl (popover do DatePicker)."
  },
  "controlSizes": {
    "button": { "md": { "height": 44, "paddingX": 16, "text": "base", "iconOnlyWidth": 48 }, "sm": { "height": 36, "paddingX": 12, "text": "sm", "iconOnlyWidth": 36 } },
    "input": { "height": 44, "paddingX": 12, "text": "sm", "border": "1px solid gray-300", "radius": "md (6px)" },
    "select": { "triggerHeight": 44 },
    "navbar": { "height": 80 },
    "iconSizes": [16, 18, 20, 24]
  },
  "breakpoints": {
    "$note": "Não há override — breakpoints default do Tailwind. App é desktop-first: 'xl' (1280px) é o breakpoint dominante e 'max-xl' o fallback para telas menores.",
    "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px",
    "usageRank": ["xl (~187)", "max-xl (~112)", "lg (~57)", "max-lg (~43)", "sm (~12)", "md (~6)", "2xl (~1)"]
  },
  "motion": {
    "keyframes": ["accordion-down", "accordion-up", "collapsible-down", "collapsible-up"],
    "animation": {
      "accordion-down": "accordion-down 0.2s ease-out",
      "accordion-up": "accordion-up 0.2s ease-out",
      "collapsible-down": "collapsible-down 0.2s ease-out",
      "collapsible-up": "collapsible-up 0.2s ease-out"
    },
    "plugin": "tailwindcss-animate",
    "transitions": "transition-colors em Button/Input; duration-200 em ícones de accordion"
  }
}
